{
  "manifest_version": 3,
  "name": "Claude Launcher",
  "version": "1.0",
  "description": "Open claude.ai with a click or Alt+C",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Open Claude"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Open claude.ai"
    }
  },
  "permissions": ["tabs"]
}
